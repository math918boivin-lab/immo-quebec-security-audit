# Copiez ce fichier vers .env.local et remplissez les valeurs.
# .env.local n'est jamais commite (voir .gitignore).

# Requis. Chaine de connexion PostgreSQL. Sur Vercel, connectez une base
# Vercel Postgres (onglet Storage du projet) : la variable POSTGRES_URL
# est alors injectee automatiquement, vous n'avez rien a faire ici en
# production. Pour le developpement local, pointez vers une instance
# Postgres locale ou une base de developpement separee.
POSTGRES_URL=postgres://postgres:postgres@localhost:5432/immo_dev

# Optionnel. Si definies ET qu'aucun utilisateur n'existe encore en base,
# ces variables creent UNE SEULE FOIS, au premier demarrage, un compte de
# demonstration pre-rempli avec des donnees fictives (mot de passe hache
# avec bcrypt avant stockage). N'importe qui peut aussi simplement creer
# son propre compte via /signup — ces variables ne sont donc pas requises.
ADMIN_EMAIL=vous@example.com
ADMIN_PASSWORD=changez-ce-mot-de-passe-tres-long-et-unique
