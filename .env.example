# Copiez ce fichier vers .env.local et remplissez les valeurs.
# .env.local n'est jamais commite (voir .gitignore).

# Identifiants du premier compte administrateur. Utilises UNE SEULE FOIS
# au premier demarrage du serveur pour creer le compte (mot de passe hache
# avec bcrypt avant d'etre stocke en base). Une fois le compte cree, ces
# variables ne sont plus necessaires et peuvent etre retirees.
ADMIN_EMAIL=vous@example.com
ADMIN_PASSWORD=changez-ce-mot-de-passe-tres-long-et-unique
